#!/bin/bash
# nvmtlctl: status, settings, cache clearing and log collection for the NVIDIA Metal driver on macOS.
# Meant for people and for a GUI to drive (every read command has --json). Commands that change things need sudo.
#   nvmtlctl telemetry --json          read-only RM metrics (requires gpu_telemetry next to this CLI)
#   nvmtlctl status [--json]            driver, macOS, GPU, plugin and encoder state
#   nvmtlctl conf list [--json]         known settings and their current values in nvrm610.conf
#   nvmtlctl conf get KEY | set KEY VALUE | unset KEY
#   nvmtlctl caches status|clear [--dry-run]   system icon caches that go stale across macOS or driver changes
#   nvmtlctl boot-check [--dry-run]     clear the caches once when the macOS build or driver version changed (for a LaunchDaemon)
#   nvmtlctl restart-windowserver       log the desktop session out and back in (the desktop restarts)
#   nvmtlctl test list|run ID [--param key=value ...]|run-all [--json]
#   nvmtlctl logs [DIR]                 collect driver state and logs into DIR (default ~/nvmtl-logs-DATE); nothing is sent anywhere
# Exit codes: 0 ok (also test fail/skip/error results), 1 tool failure, 2 usage, 3 needs sudo.
# Copyright (c) 2026 BlueMonkey
# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
VERSION=0.1
NM=/Library/NullMoth
BUNDLE=/Library/GPUBundles/NVMTLDriver.bundle/Contents/MacOS
CONF=/Library/GPUBundles/nvmtl/nvrm610.conf
KEYFILE=$NM/cache-key
JSON=0; DRY=0

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
need_root() { [ "$(id -u)" = 0 ] || { echo "nvmtlctl: this needs sudo" >&2; exit 3; }; }
jesc() {
  printf '%s' "$1" | LC_ALL=C awk '
    BEGIN { for(i=1;i<32;i++) esc[sprintf("%c",i)]=sprintf("\\u%04x",i) }
    { if(NR>1) printf "\\n"
      for(i=1;i<=length($0);i++) {
        c=substr($0,i,1)
        if(c=="\\" || c=="\"") printf "\\%s",c
        else if(c in esc) printf "%s",esc[c]
        else printf "%s",c
      }
    }'
}
jstr() { printf '"%s"' "$(jesc "$1")"; }
file_or() { [ -r "$1" ] && head -1 "$1" || echo "$2"; }
sha8() { [ -r "$1" ] && shasum -a 256 "$1" | cut -c1-8 || echo ""; }

# knob name | default | what it does (the settings that matter in practice; nvrm610.conf accepts any NVMTL_ name)
KNOBS='NVMTL_FBFETCH_WS|0|Let WindowServer read the framebuffer in shaders (off by default; unproven)
NVMTL_VT_RC|0|Bitrate control for hardware video encode (H.264/HEVC on Turing)
NVMTL_NVENC_HEVC|0|Hardware HEVC encode on Turing (experimental)
NVMTL_NO_NVENC|0|Keep video encode on Apple'"'"'s encoder
NVMTL_NO_VT_SPEC_HOOK|0|Turn off the VideoToolbox low-latency fix that Sunshine needs
NVMTL_POOL_KEEP|16|Command pools kept per process (0-256); lower avoids the per-process client limit
NVMTL_ASYNC_TEX_UPLOAD|0|Upload textures without waiting for the GPU (faster loading)
NVMTL_NO_BUFTEX_RECYCLE|0|Do not reuse buffer-backed textures (debugging)
NVMTL_VRAM_HEADROOM_MB|256|VRAM kept free before images spill to system memory'

conf_val() { [ -r "$CONF" ] && sed -n "s/^$1=//p" "$CONF" | tail -1; }

# Keep only the newest few backups of nvrm610.conf (one is made on every change).
KEEP_BACKUPS=5
prune_backups() {
  ls -1t "$CONF".bak-* 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | while read -r f; do rm -f -- "$f"; done
}

cmd_status() {
  local mac build gpu metal kx pkg plugin_sha plugin_size enc_h264 enc_hevc bargs
  mac=$(sw_vers -productVersion); build=$(sw_vers -buildVersion)
  pkg=$(file_or $NM/driver-version unknown)
  gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | sed -n 's/^ *Chipset Model: //p' | grep -i nvidia | head -1)
  metal=$(system_profiler SPDisplaysDataType 2>/dev/null | sed -n 's/^ *Metal Support: //p' | head -1)
  kx=$(kmutil showloaded --list-only 2>/dev/null | grep -o 'com\.nullmoth\.[A-Za-z]* ([0-9.]*)' | tr '\n' ',' | sed 's/,$//')
  plugin_sha=$(sha8 $BUNDLE/NVMTLDriver); plugin_size=$(stat -f %z $BUNDLE/NVMTLDriver 2>/dev/null || echo 0)
  enc_h264=$([ -e $BUNDLE/libnvenc_h264_t2d.dylib ] && echo yes || echo no)
  enc_hevc=$([ -e $BUNDLE/libnvenc_hevc_t2d.dylib ] && echo yes || echo no)
  bargs=$(nvram boot-args 2>/dev/null | cut -f2-)
  if [ $JSON = 1 ]; then
    printf '{"tool":%s,"macos":%s,"build":%s,"package":%s,"gpu":%s,"metal":%s,"kexts":%s,"plugin_sha8":%s,"plugin_bytes":%s,"turing_h264_encoder_lib":%s,"turing_hevc_encoder_lib":%s,"boot_args":%s,"cache_key":%s}\n' \
      "$(jstr $VERSION)" "$(jstr "$mac")" "$(jstr "$build")" "$(jstr "$pkg")" "$(jstr "$gpu")" "$(jstr "$metal")" "$(jstr "$kx")" "$(jstr "$plugin_sha")" "$plugin_size" "$(jstr $enc_h264)" "$(jstr $enc_hevc)" "$(jstr "$bargs")" "$(jstr "$(file_or $KEYFILE none)")"
  else
    echo "nvmtlctl $VERSION"
    echo "macOS:        $mac ($build)"
    echo "Package:      $pkg"
    echo "GPU:          ${gpu:-not found}   Metal: ${metal:-?}"
    echo "Kexts loaded: ${kx:-none}"
    echo "Plugin:       sha $plugin_sha, $plugin_size bytes"
    echo "Turing encoders: H.264 lib $enc_h264, HEVC lib $enc_hevc"
    echo "Boot args:    $bargs"
    echo "Cache key:    $(file_or $KEYFILE none)"
  fi
}

cmd_telemetry() {
  [ $JSON = 1 ] && [ $# = 0 ] || usage
  local probe; probe="$(cd "$(dirname "$0")" && pwd)/gpu_telemetry"
  if [ ! -x "$probe" ]; then
    printf '{"schema_version":1,"probe":{"error":"probe_not_installed"}}\n'
    return 1
  fi
  exec "$probe"
}

cmd_conf() {
  local sub=${1:-list}; shift || true
  case $sub in
    list)
      if [ $JSON = 1 ]; then
        local first=1; printf '['
        echo "$KNOBS" | while IFS='|' read -r k d desc; do
          [ $first = 1 ] || printf ','; first=0
          v=$(conf_val "$k"); printf '{"key":%s,"default":%s,"value":%s,"description":%s}' "$(jstr "$k")" "$(jstr "$d")" "$(jstr "${v:-$d}")" "$(jstr "$desc")"
        done; echo ']'
      else
        echo "$KNOBS" | while IFS='|' read -r k d desc; do
          v=$(conf_val "$k"); printf '%-26s %-5s (default %s)  %s\n' "$k" "${v:-$d}" "$d" "$desc"; done
        echo "(file: $CONF; keys not listed above can still be set)"
      fi ;;
    get) [ $# = 1 ] || usage; conf_val "$1" ;;
    set) [ $# = 2 ] || usage; need_root
      case $1 in NVMTL_[A-Z0-9_]*) ;; *) echo "nvmtlctl: key must look like NVMTL_NAME" >&2; exit 2;; esac
      case $2 in *[!A-Za-z0-9_.-]*|"") echo "nvmtlctl: value may only use letters, digits, _ . -" >&2; exit 2;; esac
      mkdir -p "$(dirname $CONF)"; touch $CONF
      cp $CONF "$CONF.bak-$(date +%Y%m%d-%H%M%S)"
      grep -v "^$1=" $CONF > "$CONF.new" || true; echo "$1=$2" >> "$CONF.new"; mv "$CONF.new" $CONF
      prune_backups
      echo "set $1=$2 (a backup of the old file is next to it; the newest $KEEP_BACKUPS are kept; processes read it when they start: restart the app, or the desktop for WindowServer)" ;;
    unset) [ $# = 1 ] || usage; need_root; [ -e $CONF ] || exit 0
      cp $CONF "$CONF.bak-$(date +%Y%m%d-%H%M%S)"; grep -v "^$1=" $CONF > "$CONF.new" || true; mv "$CONF.new" $CONF; prune_backups; echo "unset $1" ;;
    *) usage ;;
  esac
}

# Disposable caches whose contents depend on how the driver rendered at the time. All are rebuilt by macOS on demand.
cache_paths() {
  ls -d /Library/Caches/com.apple.iconservices.store \
        /private/var/folders/*/*/C/com.apple.iconservices \
        /private/var/folders/*/*/C/com.apple.iconservicesagent \
        /private/var/folders/*/*/C/com.apple.dock.iconcache \
        /private/var/folders/*/*/0/com.apple.dock.launchpad \
        /private/var/folders/*/*/T/com.apple.iconservicesagent 2>/dev/null
}
cmd_caches() {
  local sub=${1:-status}; shift || true
  case $sub in
    status)
      local list n; list=$(cache_paths); n=$(printf '%s' "$list" | grep -c .)
      if [ $JSON = 1 ]; then
        local first=1; printf '{"count":%s,"paths":[' "$n"
        printf '%s\n' "$list" | while read -r p; do [ -n "$p" ] || continue; [ $first = 1 ] || printf ','; first=0; printf '%s' "$(jstr "$p")"; done; echo ']}'
      else echo "$n icon-related caches present"; printf '%s\n' "$list"; fi ;;
    clear)
      [ "${1:-}" = "--dry-run" ] && DRY=1
      [ $DRY = 1 ] || need_root
      cache_paths | while read -r p; do [ -n "$p" ] || continue
        if [ $DRY = 1 ]; then echo "would remove $p"; else rm -rf "$p" && echo "removed $p"; fi; done
      [ $DRY = 1 ] || echo "done; icons are rebuilt at the next login or restart (the first one is slow, minutes, then it is normal)" ;;
    *) usage ;;
  esac
}

cmd_boot_check() {
  [ "${1:-}" = "--dry-run" ] && DRY=1
  local key now; now="$(sw_vers -buildVersion)+$(file_or $NM/driver-version unknown)+$(sha8 $BUNDLE/NVMTLDriver)"
  key=$(file_or $KEYFILE "")
  if [ "$key" = "$now" ]; then echo "cache key unchanged ($now): nothing to do"; return 0; fi
  echo "cache key changed: '${key:-none}' -> '$now'"
  if [ $DRY = 1 ]; then cmd_caches clear --dry-run; echo "would write $KEYFILE"; return 0; fi
  need_root; cmd_caches clear; mkdir -p $NM && printf '%s\n' "$now" > $KEYFILE
}

cmd_restart_ws() { need_root; echo "restarting WindowServer: the desktop session ends and comes back"; killall -9 WindowServer; }

cmd_logs() {
  local d=${1:-$HOME/nvmtl-logs-$(date +%Y%m%d-%H%M%S)}; mkdir -p "$d"
  cmd_status > "$d/status.txt" 2>&1; JSON=1 cmd_status > "$d/status.json" 2>&1
  { echo "# conf"; cat $CONF 2>/dev/null; } > "$d/conf.txt"
  cp /tmp/nvmtl.log "$d/nvmtl.log" 2>/dev/null
  { sw_vers; uname -a; kmutil showloaded --list-only 2>/dev/null | grep -i -E 'nullmoth|nvidia'; } > "$d/system.txt" 2>&1
  system_profiler SPDisplaysDataType > "$d/displays.txt" 2>&1
  ls -l $NM $BUNDLE > "$d/files.txt" 2>&1
  tail -50 $NM/lastgood.log > "$d/lastgood.txt" 2>/dev/null
  log show --last 10m --predicate 'sender CONTAINS "NVRM" OR sender CONTAINS "NVAccel" OR process == "WindowServer"' --style compact 2>/dev/null | tail -400 > "$d/system-log-10m.txt"
  ls -1t ~/Library/Logs/DiagnosticReports 2>/dev/null | head -5 | while read -r f; do cp ~/Library/Logs/DiagnosticReports/"$f" "$d/" 2>/dev/null; done
  echo "collected in $d (review it before you share it: it contains your user name in paths and the GPU state; nothing was sent)"
}

# Catalog and programs are selected together: an override never mixes with installed binaries.
tests_init() {
  local here dir
  here=$(cd "$(dirname "$0")" && pwd) || return 1
  TEST_DIR=; TEST_MANIFEST=
  # Xcode copies resources flat, so inside the app bundle the manifest sits next to this script ("$here").
  for dir in "${NVMTL_TESTS_DIR:-}" "$here/Tests" "$here" "$here/../Resources/Tests" '/Library/Application Support/GPU Control/tests'; do
    [ -n "$dir" ] && [ -r "$dir/manifest.tsv" ] || continue
    TEST_DIR=$dir; TEST_MANIFEST=$dir/manifest.tsv; return 0
  done
  echo 'nvmtlctl: no test manifest.tsv found (set NVMTL_TESTS_DIR or build the bundled tests)' >&2
  return 1
}

test_select() {
  local row
  row=$(NVMTL_QUERY_ID="$1" awk -F '\t' '$1=="T" && $2==ENVIRON["NVMTL_QUERY_ID"] {print; exit}' "$TEST_MANIFEST")
  [ -n "$row" ] || return 1
  IFS=$'\t' read -r tag tid title group description estimate runner program <<< "$row"
}

test_params() { awk -F '\t' -v id="$tid" '$1=="P" && $2==id {print}' "$TEST_MANIFEST"; }

test_availability() {
  local file
  available=false; reason="Missing or non-executable test program: $program"
  if [ "$runner" = suite ]; then
    for file in "$TEST_DIR"/test_metal_*; do
      if [ -f "$file" ] && [ -x "$file" ]; then available=true; reason=; break; fi
    done
  elif [ -f "$TEST_DIR/$program" ] && [ -x "$TEST_DIR/$program" ]; then
    available=true; reason=
  fi
}

test_param_json() {
  local tag id key label type default choices min max first=1 choice rest
  printf '['
  while IFS=$'\t' read -r tag id key label type default choices min max; do
    [ "$first" = 1 ] || printf ','; first=0
    printf '{"key":%s,"label":%s,"type":%s,"default":' "$(jstr "$key")" "$(jstr "$label")" "$(jstr "$type")"
    if [ "$type" = int ]; then
      printf '%s,"min":%s,"max":%s}' "$default" "$min" "$max"
    else
      printf '%s,"choices":[' "$(jstr "$default")"
      rest=$choices
      while :; do
        choice=${rest%%,*}; printf '%s' "$(jstr "$choice")"
        case $rest in *,*) printf ','; rest=${rest#*,};; *) break;; esac
      done
      printf ']}'
    fi
  done < <(test_params)
  printf ']'
}

cmd_test_list() {
  local tag tid title group description estimate runner program available reason first=1
  [ $JSON = 0 ] || printf '['
  while IFS=$'\t' read -r tag tid title group description estimate runner program; do
    [ "$tag" = T ] || continue
    test_availability
    if [ $JSON = 1 ]; then
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"id":%s,"title":%s,"group":%s,"description":%s,"needs_root":false,"available":%s,"unavailable_reason":' \
        "$(jstr "$tid")" "$(jstr "$title")" "$(jstr "$group")" "$(jstr "$description")" "$available"
      if [ -n "$reason" ]; then jstr "$reason"; else printf null; fi
      printf ',"estimated_seconds":%s,"params":%s}' "$estimate" "$(test_param_json)"
    else
      printf '%s: %s (available=%s)\n' "$tid" "$title" "$available"
      [ -z "$reason" ] || printf '  %s\n' "$reason"
    fi
  done < "$TEST_MANIFEST"
  [ $JSON = 0 ] || echo ']'
}

# Only nvenc_matrix's known scalar numeric fields are read, never arbitrary JSON/code.
# NSJSONSerialization may put keys and numbers on separate lines or use exponents.
test_json_number() {
  [ -r "$work/result.json" ] || return 0
  tr '\n' ' ' < "$work/result.json" | awk -v key="$1" '
    { p="\"" key "\"[[:space:]]*:[[:space:]]*"; if (match($0,p)) {
        s=substr($0,RSTART+RLENGTH)
        if (match(s,/^-?(0|[1-9][0-9]*)([.][0-9]+)?([eE][+-]?[0-9]+)?/) &&
            substr(s,RLENGTH+1,1) ~ /[[:space:],}]/) print substr(s,1,RLENGTH)
    }}'
}

test_metric() {
  local key=$1 value=$2
  # Reject NaN, infinity and malformed output before emitting a JSON number.
  if printf '%s\n' "$value" | LC_ALL=C awk '/^-?(0|[1-9][0-9]*)([.][0-9]+)?([eE][+-]?[0-9]+)?$/ {ok=1} END {exit !ok}'; then
    [ "$metrics" = '{' ] || metrics="$metrics,"
    metrics="$metrics$(jstr "$key"):$value"
  fi
}

test_encode_metrics() {
  local session token encoded=0 decoded=0 rate= psnr= p95= pair src dst value
  session=$(sed -n '/^SESSION 1 /p' "$work/output" | tail -1)
  correct=0
  for token in $session; do
    case $token in
      correct=*) correct=${token#*=};; encoded=*) encoded=${token#*=};; decoded=*) decoded=${token#*=};;
      rate=*) rate=${token#*=};; PSNR=*) psnr=${token#*=};; p95=*) p95=${token#*=};;
    esac
  done
  # Prefer the precise JSON metrics; SESSION is a fallback when the file was not written.
  for pair in encode_service_fps:fps mean_y_psnr:psnr_db latency_p95_ms:p95_ms steady_mbps:bitrate_mbps \
              encoded:encoded decoded:decoded latency_p50_ms:latency_p50_ms latency_max_ms:latency_max_ms \
              min_y_psnr:min_y_psnr mean_uv_psnr:mean_uv_psnr encode_cpu_ms_frame:encode_cpu_ms_frame \
              create_status:create_status prepare_status:prepare_status; do
    src=${pair%:*}; dst=${pair#*:}; value=$(test_json_number "$src")
    if [ -z "$value" ]; then
      case $src in mean_y_psnr) value=$psnr;; latency_p95_ms) value=$p95;; steady_mbps) value=$rate;; encoded) value=$encoded;; decoded) value=$decoded;; esac
    fi
    [ -z "$value" ] || test_metric "$dst" "$value"
    case $src in mean_y_psnr) psnr=$value;; steady_mbps) rate=$value;; encoded) encoded=$value;; decoded) decoded=$value;; esac
  done
  summary="$decoded of $encoded frames, ${rate:-unknown} Mbit/s, PSNR ${psnr:-unknown} dB"
}

test_result() {
  if [ $JSON = 1 ]; then
    printf '{"id":%s,"status":%s,"started":%s,"duration_s":%s,"summary":%s,"metrics":%s,"details":%s,"hint":' \
      "$(jstr "$requested")" "$(jstr "$status")" "$(jstr "$started")" "$duration" "$(jstr "$summary")" "$metrics" "$(jstr "$details")"
    if [ -n "$hint" ]; then jstr "$hint"; else printf null; fi
    printf '}\n'
  else
    printf '%s: %s — %s\n' "$requested" "$status" "$summary"
    [ -z "$hint" ] || printf '%s\n' "$hint"
    [ -z "$details" ] || printf '%s\n' "$details"
  fi
}

test_run() {
  local requested=${1:-} tag tid title group description estimate runner program available reason
  local started begin duration=0 status=error summary= details= hint= metrics='{' work rc=0 correct=0
  local key value label type default choices min max id param found i n=0 error= file name result
  local passed=0 failed=0 skipped=0 total=0 suite_details= size=1080p pattern=motion bitrate_mbps=8 seconds=6 codec=h264 w h
  local pkeys=() pvalues=() ptypes=() pchoices=() pmins=() pmaxs=()
  [ $# = 0 ] || shift
  started=$(date -u +%Y-%m-%dT%H:%M:%SZ); begin=$SECONDS
  if ! test_select "$requested"; then
    summary="Unknown test: $requested"
  else
    while IFS=$'\t' read -r tag id key label type default choices min max; do
      pkeys+=("$key"); pvalues+=("$default"); ptypes+=("$type"); pchoices+=("$choices"); pmins+=("$min"); pmaxs+=("$max"); n=$((n+1))
    done < <(test_params)
    while [ $# -gt 0 ]; do
      if [ "$1" != --param ] || [ $# -lt 2 ]; then error='Expected --param key=value'; break; fi
      param=$2; shift 2
      case $param in *=*) key=${param%%=*}; value=${param#*=};; *) error="Invalid parameter: $param"; break;; esac
      found=0
      for ((i=0;i<n;i++)); do
        [ "${pkeys[$i]}" = "$key" ] || continue
        found=1
        if [ "${ptypes[$i]}" = choice ]; then
          case ,${pchoices[$i]}, in *,"$value",*) [ -n "$value" ] || error="Invalid $key: $value";; *) error="Invalid $key: $value";; esac
          # A choice is one token, never a comma-separated subset of the choices.
          case $value in *,*) error="Invalid $key: $value";; esac
        else
          # Bound length before arithmetic to avoid overflow; accept canonical decimal integers.
          case $value in ''|*[!0-9]*|0[0-9]*|??????????*) error="Invalid $key: $value";;
            *) if [ "$value" -lt "${pmins[$i]}" ] || [ "$value" -gt "${pmaxs[$i]}" ]; then error="Out-of-range $key: $value"; fi;;
          esac
        fi
        [ -n "$error" ] || pvalues[$i]=$value
        break
      done
      [ "$found" = 1 ] || error="Unknown parameter: $key"
      [ -z "$error" ] || break
    done
    if [ -n "$error" ]; then summary=$error
    else
      test_availability
      if [ "$available" = false ]; then status=skip; summary=$reason
      else
        work=$(mktemp -d "${TMPDIR:-/tmp}/nvmtl-test.XXXXXX") || { echo 'nvmtlctl: cannot create test temporary directory' >&2; return 1; }
        for ((i=0;i<n;i++)); do
          case ${pkeys[$i]} in size) size=${pvalues[$i]};; pattern) pattern=${pvalues[$i]};; bitrate_mbps) bitrate_mbps=${pvalues[$i]};; seconds) seconds=${pvalues[$i]};; codec) codec=${pvalues[$i]};; esac
        done
        case $runner in
          encode)
            case $size in 720p) w=1280; h=720;; 1080p) w=1920; h=1080;; 1440p) w=2560; h=1440;; esac
            [ "$tid" != encode-hevc ] || codec=hevc
            NVENC_VT_VERBOSE=1 NVMTL_VT_RC=1 NVMTL_NVENC_HEVC=1 "$TEST_DIR/$program" "$codec" "$w" "$h" "$((seconds*60))" 60 "$((bitrate_mbps*1000000))" "$pattern" 1 "$tid" "$work/result.json" > "$work/output" 2>&1; rc=$?
            test_encode_metrics ;;
          bringup)
            NVENC_VT_VERBOSE=1 NVMTL_NVENC_HEVC=1 "$TEST_DIR/$program" "$codec" > "$work/output" 2>&1; rc=$?
            summary="$title" ;;
          program)
            "$TEST_DIR/$program" > "$work/output" 2>&1; rc=$?; summary="$title" ;;
          suite)
            : > "$work/output"
            for file in "$TEST_DIR"/test_metal_*; do
              [ -f "$file" ] || continue
              name=${file##*/}; total=$((total+1))
              if [ -x "$file" ]; then "$file" >> "$work/output" 2>&1; result=$?; else result=126; fi
              case $result in
                0) passed=$((passed+1)); result=PASS;;
                77) skipped=$((skipped+1)); result=SKIP;;
                *) failed=$((failed+1)); result=FAIL;;
              esac
              suite_details="${suite_details}${name}: $result"$'\n'
            done
            summary="$passed of $total passed"
            test_metric passed "$passed"; test_metric failed "$failed"; test_metric skipped "$skipped"; test_metric total "$total"
            if [ "$failed" -gt 0 ]; then rc=1; elif [ "$passed" = 0 ]; then rc=77; fi ;;
          *) printf 'Unknown test runner: %s\n' "$runner" > "$work/output"; rc=127; summary='Invalid test manifest runner' ;;
        esac
        case $rc in 0) status=pass;; 77) status=skip;; 126|127) status=error;; *) status=fail;; esac
        if [ "$runner" = encode ] && [ "$status" = pass ] && [ "$correct" != 1 ]; then status=fail; summary='Encoder did not report a correct session'; fi
        # -12908 alone is ambiguous; only recognized engine/map diagnostics justify this hint. A test that already
        # passed with a correct session keeps its pass: "engine already in use in this process" is logged by a
        # normal run too, so the log patterns may only explain a failure, never create one.
        if { [ "$status" = fail ] || [ "$status" = error ]; } && LC_ALL=C grep -Eiq 'cpu map -> 0x51|engine bring-up failed|StartSession.*engine refused|engine already in use' "$work/output"; then
          status=fail
          hint="The card's BAR1 window is full: quit other GPU apps or restart the Mac, then run again."
        fi
        if [ "$runner" = suite ]; then details=$suite_details; else details=$(tail -40 "$work/output"); fi
        rm -rf -- "$work"
      fi
    fi
  fi
  metrics="$metrics}"; duration=$((SECONDS-begin))
  test_result
}

cmd_test() {
  local sub=${1:-} tag id rest first=1
  [ $# = 0 ] || shift
  case $sub in list|run|run-all) ;; *) usage;; esac
  tests_init || return 1
  case $sub in
    list) [ $# = 0 ] || usage; cmd_test_list ;;
    run) test_run "$@" ;;
    run-all)
      [ $# = 0 ] || usage
      [ $JSON = 0 ] || printf '['
      while IFS=$'\t' read -r tag id rest; do
        [ "$tag" = T ] || continue
        # Keep run-all's selection variables separate from the run's dynamic locals.
        if (local tid title group description estimate runner program available reason; test_select "$id" && test_availability && [ "$available" = true ]); then
          [ $JSON = 0 ] || { [ "$first" = 1 ] || printf ','; first=0; }
          test_run "$id" || return 1
        fi
      done < "$TEST_MANIFEST"
      [ $JSON = 0 ] || echo ']' ;;
  esac
}

# argument parsing: allow --json anywhere
ARGS=(); for a in "$@"; do case $a in --json) JSON=1;; *) ARGS+=("$a");; esac; done
set -- ${ARGS[@]+"${ARGS[@]}"}
case ${1:-} in
  test) shift; cmd_test "$@" ;;
  status) cmd_status ;;
  telemetry) shift; cmd_telemetry "$@" ;;
  conf) shift; cmd_conf "$@" ;;
  caches) shift; cmd_caches "$@" ;;
  boot-check) shift; cmd_boot_check "$@" ;;
  restart-windowserver) cmd_restart_ws ;;
  logs) shift; cmd_logs "$@" ;;
  version|--version) echo "nvmtlctl $VERSION" ;;
  *) usage ;;
esac
